# Overlay for the iDEAL 5.5 backend instance.
#
# Only needed to run 5.5 and 6.0 AT THE SAME TIME. To run one at a time, just
# set VERSION=5.5 in the root .env — no overlay, no copy of this file.
#
# Usage: start the process with DV_ENV_FILE pointing at a copy of this file,
# set as a real OS environment variable on the launch (not inside a .env — it
# must exist before settings.py loads one). Task Scheduler: add it under the
# action's environment, or wrap the launch in a .bat that sets it first.
#
#   set DV_ENV_FILE=D:\iDEAL\data-variance-module-\.env.55
#   .venv\Scripts\python.exe dev_server.py
#
# Loaded AFTER the root .env with override=True, so it carries only what must
# differ per instance. Everything else — DV_DB_*_55, DV_BASE_PATH_55,
# DV_SERVER_PORT_55, DV_API_BASE_PATH_55, DV_NLP_INDEX_DIR_55 — is already
# version-keyed in the shared root .env and follows VERSION automatically.
#
# Copy this file to .env.55 (untracked) before pointing IIS at it.

VERSION=5.5

# The port and reverse-proxy prefix follow VERSION (5.5 -> 8002), so they are
# deliberately NOT repeated here. Uncomment only to override this instance:
# DV_SERVER_PORT=8002
# DV_API_BASE_PATH=/Datavariance/api
