# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# Per-instance overlays for running 5.5 and 6.0 side by side (see
# backend/config/settings.py DV_ENV_FILE) — the real files carry no secrets
# of their own (those stay in the shared root .env) but are still local
# deployment config, not template files.
.env.55
.env.60
config/env/.env.55
config/env/.env.60
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.env.development
frontend/.env.production
frontend/.env.test
!config/env/*.example
!frontend/.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/
.venv/
venv/
env/

# ── Node / frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Test / coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Local databases ───────────────────────────────────────────────────────────
*.db
*.sqlite

# ── Generated artifacts ───────────────────────────────────────────────────────
# artifacts/nlp-index/ IS tracked: the FAISS/BM25 folders are produced by an
# external build tool, not by this repo's own build, and the application cannot
# start without them. Only scratch output below it is ignored.
artifacts/**/*.tmp
artifacts/**/.cache/
