# Overlay for the iDEAL 5.5 backend instance.
#
# Usage: start this process with DV_ENV_FILE pointing at a copy of this file
# (set as a real OS env var on the process launch — see README section on
# "Running 5.5 and 6.0 side by side"). Loaded AFTER the root .env with
# override=True, so it only needs the settings that differ from 6.0's
# instance: everything else (DB_*_55, BASE_PATH_55, ...) already lives in the
# shared root .env, version-keyed.
#
# Copy this file to .env.55 (untracked) and adjust the port/base-path if
# needed before pointing IIS at it.

VERSION=5.5
DV_SERVER_PORT=8000
DV_API_BASE_PATH=/DataVar/api
