<configuration>
<system.webServer>
<rewrite>
<rules>
 
    <rule name="FastAPI Reverse Proxy" stopProcessing="true">
     <match url="^api/(.*)" />
 
     <action 
        type="Rewrite"
        url="http://127.0.0.1:8000/{R:1}"
        appendQueryString="true" />
 
    </rule>
 
   </rules>
</rewrite>
</system.webServer>
</configuration>