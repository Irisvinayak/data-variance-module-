<configuration>
  <system.webServer>
    <!-- Security headers. HSTS (Strict-Transport-Security) is intentionally left
         to the site-level IIS config because this site may be served over http.
         X-Frame-Options is deliberately NOT set: this app is meant to be iframed.
         The CSP is REPORT-ONLY so nothing can break embedding. To narrow and enforce
         it, build with VITE_HOST_ORIGIN=<host origin(s)> and VITE_CSP_ENFORCE=true
         (see frontend/csp.js); the build edits the copy in dist/, not this file. -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors *" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <!-- ============================================================
             iDEAL 5.5 deployment  (VITE_BASE_PATH=/DataVar/, backend 8004)

             This is the file the 5.5 build ships as web.config. The build
             (vite.config.js, closeBundle plugin) selects the right file per
             mode automatically: `--mode production55` keeps this file, any
             other mode copies public/web.60.config over web.config. The two
             differ in BOTH the rewrite prefix and the backend port.

             VITE_API_BASE_URL=/DataVar/api, so the browser calls
             /DataVar/api/auth/... and /DataVar/api/variance/...

             IIS matches <match url> relative to the application root and
             without a leading slash, so which rule fires depends on how this
             folder is deployed:
               - as its own IIS application/virtual directory "DataVar"
                 -> the path arrives as   api/auth/...     (rule 1)
               - as a plain subfolder of the site root
                 -> the path arrives as   DataVar/api/...  (rule 2)
             Both are listed so either layout works.
             Requires the ARR module with proxy enabled.
             ============================================================ -->
        <rule name="FastAPI Reverse Proxy (app root)" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8004/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="FastAPI Reverse Proxy (site subfolder)" stopProcessing="true">
          <match url="^DataVar/api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8004/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
