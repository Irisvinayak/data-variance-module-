<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- ============================================================
             iDEAL 6.0 deployment  (VITE_BASE_PATH=/DataVar6.0/, backend 8003)

             ***  RENAME THIS FILE TO web.config IN THE DEPLOYED dist  ***

             It ships alongside the 5.5 web.config because Vite copies public/
             verbatim and the two hosts differ in BOTH the rewrite prefix and
             the backend port, so one file cannot serve both. Leaving it named
             web.6.0.config is inert — IIS only reads web.config — so a 6.0
             deploy that forgets the rename falls through to the SPA fallback
             and every API call returns index.html instead of JSON.

             VITE_API_BASE_URL=/DataVar6.0/api, so the browser calls
             /DataVar6.0/api/auth/... and /DataVar6.0/api/variance/...

             IIS matches <match url> relative to the application root and
             without a leading slash, so which rule fires depends on how this
             folder is deployed:
               - as its own IIS application/virtual directory "DataVar6.0"
                 -> the path arrives as   api/auth/...        (rule 1)
               - as a plain subfolder of the site root
                 -> the path arrives as   DataVar6.0/api/...  (rule 2)
             Both are listed so either layout works.
             Requires the ARR module with proxy enabled.
             ============================================================ -->
        <rule name="FastAPI Reverse Proxy (app root)" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8003/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="FastAPI Reverse Proxy (site subfolder)" stopProcessing="true">
          <match url="^DataVar6\.0/api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8003/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
