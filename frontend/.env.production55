# Production build for the iDEAL 5.5 host  —  `npm run build:55`
#
# Selected with `vite build --mode production55`, which loads .env plus this
# file (NOT .env.production — that one is the 6.0 build).
#
# Vite bakes these into the bundle at BUILD time, so unlike the backend they
# cannot follow the root .env's VERSION at runtime. The deploy path and API
# prefix differ per host, so 5.5 and 6.0 need separate builds:
#   npm run build:55   -> this file           (IIS /DataVar/,     backend 8002)
#   npm run build:60   -> .env.production     (IIS /DataVar6.0/,  backend 8003)
#
# Only the deploy path is baked in. Which auth strategy the app uses is still
# decided at runtime from GET /app-config, so the backend's VERSION remains the
# single behavioural switch.

# Must match the IIS virtual directory and the web.config rewrite prefix.
# If this deployment is served from a differently-named vdir (e.g.
# /Datavariance/), change BOTH of these and the matching web.config rule.
VITE_API_BASE_URL=/DataVar/api
VITE_BASE_PATH=/DataVar/

# 5.5 backend port (DV_SERVER_PORT_55).
VITE_PROXY_TARGET=http://127.0.0.1:8002
VITE_PORT=3001
VITE_PREVIEW_PORT=4173

# Optional build-time pin of the iDEAL host version (5.5 or 6.0).
# Leave EMPTY in normal use: the app asks the backend (GET /app-config), so the
# root .env's VERSION is the single switch. Set this only for a build that
# cannot reach the backend at startup.
VITE_APP_VERSION=
