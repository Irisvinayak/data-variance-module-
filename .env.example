# =============================================================================
#  DATA VARIANCE MODULE - COMPLETE CONFIGURATION REFERENCE
# =============================================================================
#  Every setting the project reads, in one place. The values shown are the
#  defaults used when a setting is left empty or removed.
#
#  PART 1 (backend)  -> copy into the ROOT  .env   (next to dev_server.py)
#  PART 2 (frontend) -> goes in frontend/.env, frontend/.env.production (6.0)
#                       and frontend/.env.production55 (5.5). Vite reads only
#                       the frontend/ folder and bakes these values in at BUILD
#                       time, so they cannot live in the root .env.
#
#  Do NOT put real passwords in this file - it is committed to git.
# =============================================================================


# #############################################################################
#  PART 1 - BACKEND  (root .env)
# #############################################################################

# ---- Host version: THE main switch -----------------------------------------
# 5.5 = iDEAL 5.5 (single tenant)   6.0 = iDEAL 6.0 (multi tenant)
# It picks the DB, repository folder, port, API prefix, CORS and NLP index.
VERSION=5.5

# ---- Repository (XML metadata) folders --------------------------------------
DV_BASE_PATH_55=D:\Repo5.5
DV_BASE_PATH_60=D:\Repo6
# DV_BASE_PATH=                 # if set, used for BOTH versions

# ---- Oracle database: 5.5 ----------------------------------------------------
DV_DB_HOST_55=
DV_DB_PORT_55=1521
DV_DB_SERVICE_55=XE
DV_DB_USER_55=
DV_DB_PASSWORD_55=
DV_IS_SP_TABLE_DATA_ENABLED_55=false   # true = query the <TABLE>_DP tables
DV_DP_SCHEMA_55=CRILC                  # schema prefix for the _DP tables

# ---- Oracle database: 6.0 ----------------------------------------------------
DV_DB_HOST_60=
DV_DB_PORT_60=1521
DV_DB_SERVICE_60=XE
DV_DB_USER_60=
DV_DB_PASSWORD_60=
DV_IS_SP_TABLE_DATA_ENABLED_60=false
DV_DP_SCHEMA_60=IDEALCRILC

# Same DB for both versions? Set the unsuffixed form instead, e.g.
# DV_DB_HOST=  DV_DB_PORT=  DV_DB_SERVICE=  DV_DB_USER=  DV_DB_PASSWORD=
# (a _55/_60 value always wins over the unsuffixed one)

# ---- Database tuning ---------------------------------------------------------
DV_DB_MAX_ROWS=5000             # max rows fetched per query (_55/_60 allowed)
DV_DB_POOL_MIN=1
DV_DB_POOL_MAX=20               # keep near the server's thread count
DV_DB_CALL_TIMEOUT_MS=60000     # per-query timeout

# ---- Server ------------------------------------------------------------------
DV_SERVER_HOST=0.0.0.0
DV_SERVER_PORT_55=8002
DV_SERVER_PORT_60=8003
DV_API_BASE_PATH_55=            # reverse-proxy prefix, e.g. /DataVar/api
DV_API_BASE_PATH_60=            # e.g. /DataVar6.0/api
DV_CORS_ORIGINS_55=http://localhost:5173,http://localhost:3001
DV_CORS_ORIGINS_60=http://localhost:5173,http://localhost:3001
# DEV_SERVER_RELOAD=0           # 1 = auto-restart on code change (dev only)
# DV_ENV_FILE=                  # OS variable only (not in .env): overlay file
#                               # for running 5.5 and 6.0 side by side,
#                               # see config/env/*.example

# ---- Authentication ----------------------------------------------------------
DV_AUTH_ENABLED=true            # NEVER false in production
AUTH_TTL_SEC=3600               # how long a user's allowed-returns list is cached
DV_DEV_TENANT_ID=               # 6.0 tenant used only when auth is disabled, e.g. 1001
# 6.0 role-access option ids (not in use yet):
# DV_OPTION_ID_CREATE_INSTANCE=
# DV_OPTION_ID_DATA_VARIATION=

# ---- Individual file overrides (leave empty = derived from DV_BASE_PATH_*) --
# DV_RETURNS_XML_PATH=
# DV_NON_XBRL_RETURNS_XML_PATH=
# DV_TABLE_MAPPING_BASE_DIR=
# DV_INSTANCE_BASE_DIR=
# DV_XML_USER_PATH=
# DV_XML_DEPT_PATH=
# DV_XML_ROLE_ACCESS_PATH=
# DV_XML_PERIOD_PATH=
# DV_XML_TENANT_PATH=

# ---- XML attribute-name overrides (only for hand-edited master files) -------
# XML_USER_LOGIN_ATTR=
# XML_USER_DEPT_ATTR=
# XML_USER_ROLE_ATTR=
# XML_DEPT_ID_ATTR=
# XML_DEPT_FORMS_ATTR=
# XML_DEPT_NX_ATTR=

# ---- Cache lifetimes (seconds) ----------------------------------------------
DV_RETURNS_TTL_SEC=3600
DV_TABLE_MAPPING_TTL_SEC=3600
DV_XML_QUERY_TTL_SEC=3600
DV_NLP_RETURN_LOOKUP_TTL_SEC=3600

# ---- Calendar ----------------------------------------------------------------
DV_FISCAL_YEAR_START_MONTH=     # empty = 4 (Apr) for 5.5, 1 (Jan) for 6.0

# ---- Logging -----------------------------------------------------------------
DV_LOG_LEVEL=INFO               # DEBUG / INFO / WARNING / ERROR
DV_LOG_RETENTION_DAYS=30        # 0 = keep forever
# DV_LOG_DIR=                   # default: <project>/logs
# DV_AI_LOG_DIR=                # default: <logs>/ai

# ---- NLP: AI models (Ollama) -------------------------------------------------
DV_NLP_OLLAMA_URL=http://3.109.51.228/OllamaProxy/api/generate
DV_NLP_OLLAMA_MODEL=hf.co/defog/sqlcoder-7b-2:Q5_K_M   # writes SQL (/nlquery)
DV_NLP_OLLAMA_TIMEOUT_SEC=60
DV_NLP_INTENT_MODEL=qwen2.5:7b                         # picks table/column (/nlresolve)
DV_NLP_INTENT_TIMEOUT_SEC=20
DV_NLP_INTENT_NUM_PREDICT=200
DV_NLP_INTENT_FAILURE_COOLDOWN_SEC=60
DV_NLP_INTENT_MAX_COLS_PER_TABLE=40

# ---- NLP: search index -------------------------------------------------------
DV_NLP_EMBED_MODEL=BAAI/bge-large-en
DV_NLP_INDEX_DIR_55=            # default: artifacts/nlp-index/ideal-55
DV_NLP_INDEX_DIR_60=            # default: artifacts/nlp-index/ideal-60
# DV_NLP_INDEX_DIR=             # if set, used for BOTH versions

# ---- NLP: search tuning (change only if you know why) -----------------------
DV_NLP_SCOPED_RETRIEVAL=true
DV_NLP_TOP_K_TABLES=5
DV_NLP_TOP_K_COLUMNS=12
DV_NLP_TOP_K_LABELS=10
DV_NLP_MIN_TABLE_SCORE=0.25
DV_NLP_MIN_COLUMN_SCORE=0.20
DV_NLP_RRF_K=5
DV_NLP_BM25_SIGNAL_WEIGHT=1.5
DV_NLP_BM25_TOP_K=15            # default: 3 x DV_NLP_TOP_K_TABLES
DV_NLP_QA_STRONG_MATCH_THRESHOLD=0.95
DV_NLP_QA_STRONG_MATCH_BONUS=10.0
DV_NLP_QA_PREFILTER_TOP_N=20
DV_NLP_CONFIDENCE_AUTO_PROCEED=0.60   # above this: answer directly
DV_NLP_CONFIDENCE_ASK_FLOOR=0.35      # below this: ask "which return?"
DV_NLP_TIE_EPSILON=0.08
DV_NLP_MARGIN_FULL_SEPARATION=0.25


# #############################################################################
#  PART 2 - FRONTEND  (frontend/.env, .env.production, .env.production55)
# #############################################################################
#  Not read from this root file - listed here so everything is in one place.
#
#  VITE_API_BASE_URL  = URL prefix the browser puts in front of every backend
#                       call (e.g. /DataVar/api + /variance/compute).
#                       Empty in dev (the Vite proxy forwards to the backend).
#                       Must match DV_API_BASE_PATH_* and the IIS web.config.
#
#                       frontend/.env              VITE_API_BASE_URL=
#                       frontend/.env.production55 VITE_API_BASE_URL=/DataVar/api      (5.5)
#                       frontend/.env.production   VITE_API_BASE_URL=/DataVar6.0/api   (6.0)
#
#  VITE_BASE_PATH     = IIS folder the page itself is served from.
#                       dev ./   |   5.5 /DataVar/   |   6.0 /DataVar6.0/
#  VITE_PROXY_TARGET  = dev only: backend address. Empty = follows VERSION
#                       above (5.5 -> :8002, 6.0 -> :8003).
#  VITE_PORT          = dev server port (3001).
#  VITE_PREVIEW_PORT  = `npm run preview` port (4173).
#  VITE_APP_VERSION   = leave empty; the page asks the backend (/app-config).
#
#  Builds:  npm run build:55   (uses .env + .env.production55)
#           npm run build:60   (uses .env + .env.production)
